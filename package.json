{
  "name": "@kicearena/assets",
  "version": "0.1.0",
  "type": "module",
  "description": "Versioned KICE product icons, rank artwork and illustration assets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kicearena/assets.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist",
    "assets",
    "catalog.json",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./catalog.json": "./catalog.json",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json && prettier --check .",
    "demo": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/node": "25.9.1",
    "prettier": "3.8.4",
    "vite": "7.3.5",
    "sharp": "0.35.2"
  },
  "license": "MIT",
  "peerDependencies": {
    "vite": "^7.3.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "homepage": "https://github.com/kicearena/assets#readme"
}
